{
  "name": "real-time-polling",
  "version": "1.0.0",
  "description": "A real-time polling application with Node.js, Express, PostgreSQL, Prisma, and WebSockets",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:setup": "node scripts/setup-database.js",
    "test:api": "node scripts/test-api.js",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:setup"
  },
  "keywords": ["polling", "real-time", "websocket", "express", "prisma", "postgresql"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "^5.3.1",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.3.1",
    "axios": "^1.5.0"
  }
}
